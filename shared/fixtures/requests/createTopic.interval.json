      "content-type": "application/json",
      "x-quickr-channel": "ios",
      "x-quickr-expect-epoch": "22222222-2222-4222-8222-222222222222",
      "x-quickr-expect-server-id": "11111111-1111-4111-8111-111111111111"
    },
    "method": "POST",
    "path": "/api/v1/topics"
  }
}
