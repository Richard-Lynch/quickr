{
  "operation_id": "createTopic",
  "request": {
    "body": {
      "name": "Water",
      "questions": [
        {
          "key": "glasses",
          "label": "Glasses",
          "max": 20,
          "min": 0,
          "required": true,
          "type": "int"
        }
      ],
      "schedule": {
        "every_minutes": 180,
