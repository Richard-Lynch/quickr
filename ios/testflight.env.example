# Copy to ios/testflight.env (gitignored) and fill in, for make ios-testflight.
# The environment wins over this file; ios/README.md "TestFlight" says where each comes from.
# Plain KEY=VALUE lines: the file is read, never run.

# Your Apple Developer Team ID (also read from ios/Local.xcconfig when unset here).
DEVELOPMENT_TEAM=
# The App Store Connect API key (Users and Access > Integrations > Team Keys).
ASC_KEY_ID=
ASC_ISSUER_ID=
# The downloaded AuthKey_<key id>.p8, kept outside the repo.
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
